# Testmiljöns .env – monteras över produktionens .env i test-containern.
# Inga riktiga hemligheter: ingen mail, ingen AI, egen databas.
DB_CONNECTION=mysql
DB_HOST=172.17.0.1
DB_PORT=23306
DB_DATABASE=stimma_test
DB_USERNAME=stimma_test
DB_PASSWORD=stimma_test
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS=noreply@stimma.test
MAIL_FROM_NAME=Stimma test
AI_PROVIDER=none
AI_SERVER=http://127.0.0.1:9
AI_API_KEY=
SYSTEM_NAME=Stimma test
SYSTEM_URL=https://stimma.test
AUTH_TOKEN_EXPIRY_MINUTES=15
SESSION_LIFETIME_HOURS=8
REMEMBER_TOKEN_HOURS=720
PUB_PDF_DIR=/var/www/html/tests/fixtures
# Tecknade avtal sparas som filer (2026-11-09); skrivbar montering, töms av testet
PUB_SIGNED_DIR=/var/www/html/tests/runtime/pub_signerade
# AI-tutorn via egen leverantör (2026-11-03) – den falska servern i tests/ai_stub.php
AI_TUTOR_API_KEY=sk_ber_testnyckel
AI_TUTOR_SERVER=http://127.0.0.1:2626/v1/chat/completions
