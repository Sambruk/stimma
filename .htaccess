# Stimma Root Security
# Block access to sensitive files and directories

# Pass Authorization header to PHP (needed for API Bearer tokens)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Block dotfiles (except .htaccess itself)
<FilesMatch "^\.(?!htaccess)">
    Require all denied
</FilesMatch>

# Block specific sensitive files
<FilesMatch "^(docker-compose\.yml|docker-compose\.yaml|init\.sql|TODO\.md|SECURITY\.md|README\.md|LICENSE|LICENSE-AND-TRADEMARK\.md|allowed_domains\.txt|email_list\.txt|import_users\.sql|xstimmainfo\.html|Dockerfile|\.gitignore|composer\.json|composer\.lock)$">
    Require all denied
</FilesMatch>

# Block ALL markdown and example/template files.
# Den namnbaserade listan ovan är en allowlist som lätt hamnar på efterkälken —
# VULNERABILITIES.md, CLEANUP-REPORT.md, REPORT.md, CHANGELOG.md och env.example
# låg publikt läsbara innan detta lades till (2026-08-13). Mönstren nedan täcker
# framtida filer automatiskt.
<FilesMatch "\.(md|markdown)$">
    Require all denied
</FilesMatch>
<FilesMatch "(^|\.)(example|sample|dist|bak|old|orig|swp|log)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(example|sample|dist|bak|old|orig|swp|sql|yml|yaml|ini|sh)$">
    Require all denied
</FilesMatch>

# Block .git directory
RedirectMatch 404 /\.git

# Block db directory (database files)
RedirectMatch 404 ^/db/

# Block migrations directory from direct access
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^migrations/ - [F,L]
</IfModule>

# Disable directory listing
Options -Indexes
