# Stimma Environment Configuration

GIT_PAT=your_github_personal_access_token

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=stimma
DB_USERNAME=stimma_user
DB_PASSWORD=your_secure_database_password

# Mail Configuration
MAIL_HOST=your_mail_server
MAIL_PORT=25
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Stimma"
MAIL_SMTP_AUTH=true
MAIL_SMTP_DEBUG=0
# Allowed domains configured in allowed_domains.txt

# AI configuration (optional - configure with your API key)
AI_PROVIDER=openai
AI_SERVER=
AI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4o-mini
AI_MAX_COMPLETION_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TOP_P=0.9
AI_STREAM=false
AI_MAX_MESSAGE_LENGTH=1000
AI_RATE_LIMIT_REQUESTS=50
AI_RATE_LIMIT_MINUTES=5

# System parameters
SYSTEM_NAME="Stimma"
SYSTEM_DESCRIPTION="Lär dig i små steg"
SYSTEM_LOGO="/images/logo.png"
SYSTEM_COLOR="#007bff"
SYSTEM_FONT="Arial, sans-serif"
SYSTEM_FONT_SIZE=16
SYSTEM_URL=https://your-domain.example.com
SYSTEM_VERSION=1.0
SYSTEM_SHOW_CONTACT_INFO=true

# Auth parameters
AUTH_TOKEN_EXPIRY_MINUTES=15
SESSION_REGENERATE_MINUTES=30
SESSION_LIFETIME_HOURS=8
REMEMBER_TOKEN_HOURS=720

# E-postlarm: cron/mail_health_alert.php larmar hit när utskicken misslyckas i rad.
# LARM_MAIL_* är en separat SMTP-väg för själva larmet (tom = ordinarie MAIL_*).
MAIL_ALERT_EMAIL=
LARM_MAIL_HOST=
LARM_MAIL_PORT=25
LARM_MAIL_USERNAME=
LARM_MAIL_PASSWORD=
LARM_MAIL_ENCRYPTION=

# AI-tutorn via egen leverantör: Berget AI, inferens i Sverige (2026-11-03).
# Tom nyckel = tutorn går via AI_* ovan. Med nyckel ignoreras modellvalet för chat i adminvyn.
AI_TUTOR_API_KEY=
AI_TUTOR_SERVER=https://api.berget.ai/v1/chat/completions
AI_TUTOR_MODEL=mistralai/Mistral-Small-3.2-24B-Instruct-2506
